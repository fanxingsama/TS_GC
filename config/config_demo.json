{
    "model": {
        "type": "PredictModel",
        "args": {
            "d_model": 256,
            "n_head": 4,
            "n_layers": 1,
            "tcn_channels": 32,
            "tcn_kernel": 3,
            "tcn_dropout": 0.3,
            "ffn_hidden": 512,
            "drop_prob": 0,
            "tau": 100
        }
    },
    "data_loader": {
        "type": "TimeseriesDataLoader",
        "args": {
            "data_dir": "data/fMRI/timeseries9.csv",
            "gc_dir": "data/fMRI/sim9_gt_processed.csv",
            "batch_size": 128,
            "data_seed":42,
            "input_window": 20,
            "output_window": 1
        }
    },
    "optimizer": {
        "type": "Adam",
        "args":{
            "lr": 0.01,
            "weight_decay": 0,
            "amsgrad": true
        }
    },
    "loss": "masked_mse_torch",
    "metrics": ["masked_mse_torch"],
    "lr_scheduler": {
        "type": "StepLR",
        "args": {
            "step_size": 30,
            "gamma": 0.1
        }
    },
    "trainer": {
        "epochs": 500,
        "lam": 0
    },
    "explainer": {
        "m": 1,
        "n": 2
    }
}
